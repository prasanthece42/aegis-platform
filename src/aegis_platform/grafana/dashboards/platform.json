{
  "uid": "aegis-platform",
  "title": "Aegis / Platform Overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "aegis",
    "operator-only",
    "local-candidate"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "cluster",
        "type": "custom",
        "query": "kind-local",
        "current": {
          "text": "kind-local",
          "value": "kind-local"
        },
        "options": []
      },
      {
        "name": "namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "aegis-prometheus"
        },
        "query": "label_values(k8s_pod_cpu_usage{aegis_cluster_uid=\"$cluster\"}, k8s_namespace_name)",
        "refresh": 1,
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "title": "Local operator candidate",
      "type": "text",
      "options": {
        "mode": "markdown",
        "content": "Data availability depends on deployed instrumentation. Missing data is unknown, never healthy. Variables are navigation filters, not authorization controls."
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Telemetry scrape availability",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "aegis-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{aegis_cluster_uid=\"$cluster\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "links": [
            {
              "title": "Investigate logs and traces",
              "url": "/d/aegis-investigation?var-cluster=${cluster}&var-namespace=${namespace}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {},
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Container readiness",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "aegis-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "k8s_container_ready{aegis_cluster_uid=\"$cluster\",k8s_namespace_name=\"$namespace\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "links": [
            {
              "title": "Investigate logs and traces",
              "url": "/d/aegis-investigation?var-cluster=${cluster}&var-namespace=${namespace}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {},
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Node CPU usage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "aegis-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "k8s_node_cpu_usage{aegis_cluster_uid=\"$cluster\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "links": [
            {
              "title": "Investigate logs and traces",
              "url": "/d/aegis-investigation?var-cluster=${cluster}&var-namespace=${namespace}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {},
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Node memory usage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "aegis-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "k8s_node_memory_usage_bytes{aegis_cluster_uid=\"$cluster\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "links": [
            {
              "title": "Investigate logs and traces",
              "url": "/d/aegis-investigation?var-cluster=${cluster}&var-namespace=${namespace}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {},
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Active alerts",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "aegis-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{aegis_cluster_uid=\"$cluster\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "links": [
            {
              "title": "Investigate logs and traces",
              "url": "/d/aegis-investigation?var-cluster=${cluster}&var-namespace=${namespace}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {},
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Registered applications \u2014 future instrumentation",
      "type": "text",
      "options": {
        "mode": "markdown",
        "content": "No catalog metric is exported. Kubernetes workload counts are not registered application counts."
      },
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      }
    }
  ],
  "links": [
    {
      "title": "Application logs and traces",
      "type": "link",
      "url": "/d/aegis-investigation?var-cluster=${cluster}&var-namespace=${namespace}",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    }
  ]
}
