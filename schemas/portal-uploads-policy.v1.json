{
  "additionalProperties": false,
  "properties": {
    "owner": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$",
      "title": "Owner",
      "type": "string"
    },
    "owner_type": {
      "enum": [
        "User",
        "Organization"
      ],
      "title": "Owner Type",
      "type": "string"
    },
    "visibility": {
      "const": "public",
      "default": "public",
      "title": "Visibility",
      "type": "string"
    },
    "storage_class": {
      "pattern": "^[a-z0-9][a-z0-9.-]{0,62}$",
      "title": "Storage Class",
      "type": "string"
    },
    "storage_size": {
      "const": "1Gi",
      "default": "1Gi",
      "title": "Storage Size",
      "type": "string"
    }
  },
  "required": [
    "owner",
    "owner_type",
    "storage_class"
  ],
  "title": "PortalUploadPolicy",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
