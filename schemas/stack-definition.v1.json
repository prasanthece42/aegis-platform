{
  "$defs": {
    "StackService": {
      "additionalProperties": false,
      "properties": {
        "context": {
          "default": ".",
          "title": "Context",
          "type": "string"
        },
        "dockerfile": {
          "default": "Dockerfile",
          "title": "Dockerfile",
          "type": "string"
        },
        "build_args": {
          "maxProperties": 8,
          "patternProperties": {
            "^[A-Z][A-Z0-9_]{0,63}$": {
              "type": "string"
            }
          },
          "title": "Build Args",
          "type": "object"
        },
        "port": {
          "default": 8000,
          "maximum": 65535,
          "minimum": 1024,
          "title": "Port",
          "type": "integer"
        },
        "health_path": {
          "default": "/ready",
          "title": "Health Path",
          "type": "string"
        },
        "replicas": {
          "default": 1,
          "maximum": 2,
          "minimum": 1,
          "title": "Replicas",
          "type": "integer"
        },
        "env": {
          "maxProperties": 32,
          "patternProperties": {
            "^[A-Z][A-Z0-9_]{0,63}$": {
              "type": "string"
            }
          },
          "title": "Env",
          "type": "object"
        },
        "service_env": {
          "maxProperties": 8,
          "patternProperties": {
            "^[A-Z][A-Z0-9_]{0,63}$": {
              "pattern": "^[a-z](?:[a-z0-9-]{0,20}[a-z0-9])?$",
              "type": "string"
            }
          },
          "title": "Service Env",
          "type": "object"
        },
        "secret_env": {
          "maxProperties": 8,
          "patternProperties": {
            "^[A-Z][A-Z0-9_]{0,63}$": {
              "pattern": "^[a-z][a-z0-9-]{0,63}$",
              "type": "string"
            }
          },
          "title": "Secret Env",
          "type": "object"
        }
      },
      "title": "StackService",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "profile_id": {
      "const": "python312-multiservice",
      "default": "python312-multiservice",
      "title": "Profile Id",
      "type": "string"
    },
    "primary_service": {
      "pattern": "^[a-z](?:[a-z0-9-]{0,20}[a-z0-9])?$",
      "title": "Primary Service",
      "type": "string"
    },
    "services": {
      "maxProperties": 8,
      "minProperties": 2,
      "patternProperties": {
        "^[a-z](?:[a-z0-9-]{0,20}[a-z0-9])?$": {
          "$ref": "#/$defs/StackService"
        }
      },
      "title": "Services",
      "type": "object"
    },
    "dependencies": {
      "const": "postgres17-redis7-nginx",
      "default": "postgres17-redis7-nginx",
      "title": "Dependencies",
      "type": "string"
    }
  },
  "required": [
    "primary_service",
    "services"
  ],
  "title": "StackDefinition",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
