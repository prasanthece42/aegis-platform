      "type": "string"
    },
    "workflow_run_id": {
      "maxLength": 24,
      "pattern": "^[1-9][0-9]*$",
      "title": "Workflow Run Id",
      "type": "string"
    },
    "run_attempt": {
      "maxLength": 24,
      "pattern": "^[1-9][0-9]*$",
      "title": "Run Attempt",
      "type": "string"
    },
    "platform_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Platform Commit",
      "type": "string"
    },
    "schema_version": {
      "const": 4,
      "default": 4,
      "title": "Schema Version",
      "type": "integer"
    },
    "release_tag": {
      "title": "Release Tag",
      "type": "string"
    },
    "verified_at": {
      "title": "Verified At",
      "type": "string"
    },
    "image": {
      "title": "Image",
      "type": "string"
    },
    "platforms": {
      "additionalProperties": {
        "$ref": "#/$defs/PublishedPlatform"
      },
      "title": "Platforms",
      "type": "object"
    },
    "bundle_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Bundle Sha256",
      "type": "string"
    },
    "provenance": {
      "const": "Unsigned workflow evidence; admission must verify GitHub source/run identity",
      "title": "Provenance",
      "type": "string"
    },
    "stack": {
      "$ref": "#/$defs/StackDefinition"
    },
    "stack_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Stack Sha256",
      "type": "string"
    },
    "primary_bundle_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Primary Bundle Sha256",
      "type": "string"
    },
    "components": {
      "maxProperties": 7,
      "minProperties": 1,
      "patternProperties": {
        "^[a-z](?:[a-z0-9-]{0,20}[a-z0-9])?$": {
          "$ref": "#/$defs/ComponentEvidence"
        }
      },
      "title": "Components",
      "type": "object"
    },
    "dependency_images": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Dependency Images",
      "type": "object"
    },
    "integration_tests": {
      "const": "passed",
      "title": "Integration Tests",
      "type": "string"
    }
  },
  "required": [
    "app_id",
    "source_repository",
    "source_repository_id",
    "source_commit",
    "workflow_run_id",
    "run_attempt",
    "platform_commit",
    "release_tag",
    "verified_at",
    "image",
    "platforms",
    "bundle_sha256",
    "provenance",
    "stack",
    "stack_sha256",
    "primary_bundle_sha256",
    "components",
    "dependency_images",
    "integration_tests"
  ],
  "title": "StackReleaseEvidence",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
