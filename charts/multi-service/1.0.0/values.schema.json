{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["appId", "environment", "sourceCommit", "image", "stackSha256", "images", "plan"],
  "properties": {
    "appId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,39}$"},
    "environment": {"enum": ["dev", "staging", "prod"]},
    "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "image": {"type": "object", "additionalProperties": false, "required": ["repository", "digest", "pullPolicy"], "properties": {
      "repository": {"type": "string", "pattern": "^ghcr.io/[a-z0-9_./-]+$"},
      "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "pullPolicy": {"const": "Never"}
    }},
    "stackSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "images": {"type": "object", "minProperties": 5, "maxProperties": 11, "additionalProperties": {"type": "string", "pattern": "^[a-z0-9./_-]+@sha256:[0-9a-f]{64}$"}},
    "plan": {"type": "array", "minItems": 14, "maxItems": 27, "items": {"type": "object", "required": ["apiVersion", "kind", "metadata"], "properties": {"kind": {"enum": ["ServiceAccount", "Deployment", "StatefulSet", "Service", "ConfigMap", "PersistentVolumeClaim"]}}}}
  }
}
