name: Aegis Python stack release
on:
  workflow_call:
    inputs:
      app-id: {type: string, required: true}
permissions:
  contents: read
  actions: read
concurrency:
  group: aegis-stack-release-${{ github.repository_id }}
  cancel-in-progress: false
jobs:
  prepare:
    name: "Resolve stack release"
    runs-on: ubuntu-24.04
    timeout-minutes: 5
    outputs:
      platform_repository: ${{ steps.resolve.outputs.platform_repository }}
      platform_commit: ${{ steps.resolve.outputs.platform_commit }}
      platforms: ${{ steps.resolve.outputs.platforms }}
      run_started_at: ${{ steps.resolve.outputs.run_started_at }}
    steps:
      - name: Resolve the immutable stack workflow
        id: resolve
        env:
          GH_TOKEN: ${{ github.token }}
          AEGIS_APP_ID: ${{ inputs.app-id }}
          AEGIS_PLATFORMS: '["amd64","arm64"]'
          AEGIS_PORT: '8080'
          AEGIS_HEALTH_PATH: /health
          AEGIS_EXPORT_CANDIDATE: 'true'
        shell: python
        run: |
__AEGIS_BOOTSTRAP__
  validate:
    needs: prepare
    uses: ./.github/workflows/python-stack-ci.yml
    permissions:
      contents: read
      actions: read
    with:
      app-id: ${{ inputs.app-id }}
      platforms: '["amd64","arm64"]'
      export-candidate: true
  publish:
    name: "08 Publish release (${{ matrix.arch }})"
    needs: [prepare, validate]
    runs-on: ${{ matrix.arch == 'arm64' && 'ubuntu-24.04-arm' || 'ubuntu-24.04' }}
    timeout-minutes: 30
    permissions:
      contents: read
      actions: read
      packages: write
    strategy:
      fail-fast: false
      matrix:
        arch: [amd64, arm64]
    env:
      APP_ID: ${{ inputs.app-id }}
      PLATFORM_COMMIT: ${{ needs.prepare.outputs.platform_commit }}
      ARCH: ${{ matrix.arch }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          repository: ${{ needs.prepare.outputs.platform_repository }}
          ref: ${{ needs.prepare.outputs.platform_commit }}
          path: platform
          persist-credentials: false
      - uses: actions/setup-python@6d4fd22b20465ccc0f7354476588e8df7c9ca0e0 # v7.1.0
        with:
          python-version: '3.12'
      - run: python -m pip install --require-hashes -r platform/requirements.txt
      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          name: ${{ inputs.app-id }}-stack-candidate-${{ matrix.arch }}-${{ github.run_id }}-${{ github.run_attempt }}
          path: candidate
      - uses: docker/login-action@81c6f93d4bc991e510b342a00b419b3bb4efc5c6 # v4.7.0
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}
      - name: Install OCI transport and authenticate
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          REGISTRY_USER: ${{ github.actor }}
        run: |
          sudo apt-get update
          sudo apt-get install --yes skopeo
          printf '%s' "$GH_TOKEN" | skopeo login --username "$REGISTRY_USER" --password-stdin ghcr.io
      - name: Verify bytes, publish digests and exercise the pulled stack
        run: python platform/tooling/stack_publish.py platform
      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: ${{ inputs.app-id }}-stack-platform-${{ matrix.arch }}-${{ github.run_id }}-${{ github.run_attempt }}
          path: published/
          retention-days: 14
          if-no-files-found: error
  assemble:
    name: "08 Verify release"
    needs: [prepare, publish]
    runs-on: ubuntu-24.04
    timeout-minutes: 30
    permissions:
      contents: write
      packages: write
      actions: read
    env:
      APP_ID: ${{ inputs.app-id }}
      PLATFORM_COMMIT: ${{ needs.prepare.outputs.platform_commit }}
      RUN_STARTED_AT: ${{ needs.prepare.outputs.run_started_at }}
      GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          repository: ${{ needs.prepare.outputs.platform_repository }}
          ref: ${{ needs.prepare.outputs.platform_commit }}
          path: platform
          persist-credentials: false
      - uses: actions/setup-python@6d4fd22b20465ccc0f7354476588e8df7c9ca0e0 # v7.1.0
        with:
          python-version: '3.12'
      - run: python -m pip install --require-hashes -r platform/requirements.txt
      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          pattern: ${{ inputs.app-id }}-stack-platform-*-${{ github.run_id }}-${{ github.run_attempt }}
          path: platform-evidence
      - uses: docker/login-action@81c6f93d4bc991e510b342a00b419b3bb4efc5c6 # v4.7.0
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}
      - name: Install OCI transport and authenticate
        env:
          REGISTRY_USER: ${{ github.actor }}
        run: |
          sudo apt-get update
          sudo apt-get install --yes skopeo
          printf '%s' "$GH_TOKEN" | skopeo login --username "$REGISTRY_USER" --password-stdin ghcr.io
      - name: Verify every OCI graph and publish one immutable application release
        run: python platform/tooling/stack_publish.py assemble
